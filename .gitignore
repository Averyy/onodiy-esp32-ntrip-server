# Build
build/
sdkconfig.old

# IDE
.vscode/
.idea/

# Private reference material: deny by default. Everything under reference/
# stays local unless it is re-included here by name (hardware notes only).
reference/*
!reference/antenna-specs.md
!reference/um982-board-onocoy.md
# Backstop in case a directory above is ever re-included.
reference/**/*.bin

# Agent notes and local tool settings: deny by default, re-include by name.
.claude/*

# ESP-IDF
managed_components/
# Generated per checkout by `idf.py set-target`/menuconfig; the committed
# baseline is sdkconfig.defaults.
sdkconfig
# dependencies.lock is committed on purpose (reproducible managed-component
# versions for CI and release builds).
# Editor/clangd caches
.cache/
compile_commands.json

# macOS
.DS_Store

# Bench tool run logs (tools/bench; default ./bench-logs wherever they run)
bench-logs/
