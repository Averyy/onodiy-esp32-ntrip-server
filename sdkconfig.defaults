# SPDX-FileCopyrightText: 2026 Avery L.
# SPDX-License-Identifier: MIT
#
# Defaults for the UM982 + ESP32-S3-WROOM-1 N16R8 station board.
# Every symbol here is checked against ESP-IDF v6.1 Kconfig; CI fails if the
# build log shows "unknown kconfig symbol" or "but is not visible".

# ---- Target and flash (N16R8: 16 MB quad flash, 8 MB octal PSRAM) ----------
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# 64 KB for the bootloader (room for secure boot / flash encryption later).
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# ---- PSRAM ----------------------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Large buffers (RTCM ring, JSON) may live in PSRAM statically.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Log ring kept across software/panic/watchdog resets (EXT_RAM_NOINIT_ATTR).
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
# Wi-Fi/lwIP buffers try PSRAM first; internal RAM stays free for stacks/DMA.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Execute code and read constants from PSRAM (copied from flash at boot).
# Flash erase/write then no longer disables the cache, so the GNSS RX task,
# Wi-Fi and the casters keep running during OTA, package downloads and NVS
# writes (as long as no flash mmap is held open).
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# ---- Flash operations: latency over throughput ------------------------------
# 4 KB sector erases only (no multi-second worst-case 64 KB block erase).
CONFIG_SPI_FLASH_BYPASS_BLOCK_ERASE=y

# ---- CPU / RTOS -----------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 1 ms tick: fine-grained UART/transfer timeouts and caster pacing.
CONFIG_FREERTOS_HZ=1000
# Per-task CPU/stack statistics for the diagnostics page. 64-bit run-time
# counter (a 32-bit 1 MHz counter wraps every ~71 min); core id in task info.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
# RTCM hub wakes consumers on notification index 1 (index 0 is used by IDF APIs).
CONFIG_FREERTOS_TASK_NOTIFICATION_ARRAY_ENTRIES=2
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# ---- Compiler -------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y

# ---- Console: UART0 (CH343P); built-in USB off -----------------------------
# The board's ESP32S3 USB-C port reaches one of two things, depending on which
# way round the plug goes in: a CH343P USB bridge on UART0 (GPIO43/44), or,
# turned over, the chip's built-in USB Serial/JTAG (GPIO19/20). The console
# is the stock UART0 console at 115200, the same rate the ROM bootloader
# prints at, so one serial capture sees everything from reset onwards; the
# bench console takes its input there. The default console has no baud
# setting of its own (it is always 115200), so CONFIG_ESP_CONSOLE_UART_BAUDRATE
# is not set here: Kconfig would ignore it and report it as not visible.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
# No IDF secondary console: it copies stdout only (the log takes diag's own
# console path), and to a host that does not read, it waits up to 50 ms per
# stall (usb_serial_jtag_vfs.c). diag can copy its console to the built-in USB
# itself, never waiting, so that either way round shows the log and esptool
# can reset the chip into download mode through either side
# (CONFIG_DIAG_CONSOLE_USB_MIRROR, components/diag/Kconfig). That copy is off
# here and on in bench builds (sdkconfig.bench) only: it keeps the USB PHY
# powered while Wi-Fi runs, host or no host.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# So the app turns the built-in USB's clock off (the ROM and the bootloader
# still use it), and Wi-Fi init powers the USB PHY down (the S3 default keeps
# it on, which the IDF help says can lower Wi-Fi performance). The copy
# selects both back on, and a build directory that had it on keeps both on
# after it is turned off: set all three to n in its sdkconfig, or start a new
# build directory (the configure step warns when the USB PHY is on outside a
# bench build, or without the copy):
#   CONFIG_DIAG_CONSOLE_USB_MIRROR=n
#   CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
#   CONFIG_ESP_PHY_ENABLE_USB=n
# CI refuses a station build with any of the three on.
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
CONFIG_ESP_PHY_ENABLE_USB=n

# ---- GNSS UART: keep receiving while flash is being written ----------------
CONFIG_UART_ISR_IN_IRAM=y

# ---- Watchdogs, panic, core dump -------------------------------------------
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# ---- OTA: app rollback if a new image never confirms itself ----------------
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- TLS: full CA bundle (GitHub, its asset CDN, TLS casters) --------------
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Chains whose top certificate is a cross-signed copy of a bundled root (the
# Onocoy TLS port serves one) verify against the bundled root. ~700 B heap.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# ---- HTTP server (web UI + WebSocket) --------------------------------------
CONFIG_HTTPD_WS_SUPPORT=y
# The handshake is refused with an HTTP error (401, 403, 421, 503) before the
# upgrade; the client is registered right after it.
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# ---- Networking -------------------------------------------------------------
# Casters (up to 8) + web clients (httpd 7) + captive DNS + OTA + SNTP + probes.
CONFIG_LWIP_MAX_SOCKETS=24
# Same budget for TCP PCBs. With none left, lwIP frees the oldest one in
# TIME_WAIT, then one in LAST_ACK, CLOSING, FIN_WAIT_2 or FIN_WAIT_1, and only
# then an open connection of lower priority (tcp.c, tcp_alloc). Every socket
# gets the same priority, so 24 open connections would refuse the next web
# client or OTA download.
CONFIG_LWIP_MAX_ACTIVE_TCP=24
CONFIG_LWIP_LOCAL_HOSTNAME="onocoydiy"
# DNS fallback server used when DHCP leaves no working one (needs
# LWIP_DNS_MAX_SERVERS >= 3, the default). Compile-time, not a user setting.
CONFIG_LWIP_FALLBACK_DNS_SERVER_SUPPORT=y
CONFIG_LWIP_FALLBACK_DNS_SERVER_ADDRESS="1.1.1.1"
# Wi-Fi credentials are owned by the settings component, not the driver.
CONFIG_ESP_WIFI_NVS_ENABLED=n
# 802.11k radio measurements and 802.11v BSS transition management: a mesh
# can steer the station to another node of the network (CONFIG_NETWORK_ROAM
# turns them on per connection and filters the requests, network.c).
CONFIG_ESP_WIFI_11KV_SUPPORT=y
CONFIG_ESP_WIFI_RRM_SUPPORT=y
CONFIG_ESP_WIFI_WNM_SUPPORT=y
# SNTP: a DHCP-provided NTP server (option 42) at index 0, pool.ntp.org at
# index 1, so networks that block outside NTP still get the time.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2
# FIONREAD on sockets (lwIP answers it only with this): the web server's
# lingering close reads exactly the bytes a refused client still has queued
# and never the client's FIN behind them (components/web/web.c,
# web_linger_close). The receive limit itself stays lwIP's default (none).
CONFIG_LWIP_SO_RCVBUF=y
# TIME_WAIT (and the longest LAST_ACK) is 2 x MSL: 10 s instead of the 120 s
# of lwIP's default. The web server ends a connection first after "Connection:
# close" or HTTP/1.0 (HTTP requires it), after a refusal with a body and when
# it evicts an idle connection; the station then holds that client port in
# TIME_WAIT and takes no new connection on it at once (tcp_in.c,
# tcp_timewait_input). A new SYN from that port gets a bare ACK: not reopening
# from TIME_WAIT is upstream lwIP's choice, and optional (RFC 9293 section
# 3.6.1). The client answers that ACK with a reset. lwIP alone ignores it (RFC
# 1337's fix against TIME-WAIT assassination, an Informational RFC); RFC 9293
# section 3.10.7.4 ends TIME_WAIT on it, as Linux does by default, and so does
# this firmware's lwIP hook when the reset carries exactly the station's
# RCV.NXT and no socket holds the connection any more (the web server's
# lingering close lets go of it as it enters TIME_WAIT; both in
# components/network/net_tw.c): the client's next SYN is taken. Linux (5.10
# and later) sends it a few milliseconds after its reset. Measured with Linux
# 7.0 against this firmware in QEMU on a tap network, back on its port 1 to 9
# s after the station's close: connected within 0.04 s, where it waited 2.1 to
# 10.2 s without the hook. Linux clients (since 2022, stable kernels too) take
# the local ports of their connections to one server from a starting point
# drawn anew every 10 s, so now and then a new connection lands on a port the
# station still holds. Until the 10 s and the hook, such a client waited up to
# 2 minutes, or its connect() failed: our configuration's fault. The 10 s
# remain the bound for a client whose reset does not come or does not match:
# it waits 15 s at most (Linux sends the SYN again 1, 3, 7 and 15 s after the
# first; since 6.5 each second up to 5 s, then at 7 and 11 s). A SYN that
# falls inside the old connection's window (rare: a client's new initial
# sequence number lands there by chance) gets a reset instead, and that
# client's connect() fails at once. Not for memory: TIME_WAIT pcbs count among
# the 24 above, and lwIP frees the oldest on demand. A stale segment would
# have to outlive 10 s and fall inside the new connection's window (the
# station's initial sequence numbers follow RFC 6528): not plausible on a
# LAN. The station's own outgoing connections skip every port lwIP still
# holds (tcp.c, tcp_new_port).
CONFIG_LWIP_TCP_MSL=5000

# ---- mDNS (espressif/mdns, network component): <hostname>.local -----------
# One service (the web page, _http._tcp) plus a spare. The responder only
# answers: no browsing, no console commands. Its data lives in PSRAM, and so
# does its task stack (the component's default size, 4096): the component
# allocates that stack with MALLOC_CAP_SPIRAM and creates the task on it
# (xTaskCreateStaticPinnedToCore; FREERTOS_TASK_CREATE_ALLOW_EXT_MEM is on by
# default on the ESP32-S3). A stack in PSRAM must never be in use while the
# cache is off: the mDNS task does no flash or NVS work, and its one callback
# into the station (the rename note in network.c) copies a string under a
# spinlock. That keeps 4 KB of internal RAM free. The default lwIP raw-PCB
# networking is kept (MDNS_NETWORKING_SOCKET off), so it uses none of the 24
# lwIP sockets. The predefined STA and AP interfaces stay on (component
# defaults): the name answers on the home network and on the setup/recovery
# AP (192.168.4.1 there).
CONFIG_MDNS_MAX_SERVICES=2
CONFIG_MDNS_ENABLE_BROWSE=n
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
# No interface uses the predefined Ethernet key: the station has no Ethernet,
# and the QEMU build's emulated Ethernet port registers under the station
# key (so mDNS answers there through the STA interface).
CONFIG_MDNS_PREDEF_NETIF_ETH=n
