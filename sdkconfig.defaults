#
# Defaults for the UM982 + ESP32-S3-WROOM-1 N16R8 station board.
# Every symbol here is checked against ESP-IDF v6.1 Kconfig; CI fails if the
# build log shows "unknown kconfig symbol" or "but is not visible".

# ---- Target and flash (N16R8: 16 MB quad flash, 8 MB octal PSRAM) ----------
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
# 64 KB for the bootloader (room for secure boot / flash encryption later).
CONFIG_PARTITION_TABLE_OFFSET=0x10000

# ---- PSRAM ----------------------------------------------------------------
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# Large buffers (RTCM ring, JSON) may live in PSRAM statically.
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
# Log ring kept across software/panic/watchdog resets (EXT_RAM_NOINIT_ATTR).
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
# Wi-Fi/lwIP buffers try PSRAM first; internal RAM stays free for stacks/DMA.
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Execute code and read constants from PSRAM (copied from flash at boot).
# Flash erase/write then no longer disables the cache, so the GNSS RX task,
# Wi-Fi and the casters keep running during OTA, package downloads and NVS
# writes (as long as no flash mmap is held open).
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# ---- Flash operations: latency over throughput ------------------------------
# 4 KB sector erases only (no multi-second worst-case 64 KB block erase).
CONFIG_SPI_FLASH_BYPASS_BLOCK_ERASE=y

# ---- CPU / RTOS -----------------------------------------------------------
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
# 1 ms tick: fine-grained UART/transfer timeouts and caster pacing.
CONFIG_FREERTOS_HZ=1000
# Per-task CPU/stack statistics for the diagnostics page. 64-bit run-time
# counter (a 32-bit 1 MHz counter wraps every ~71 min); core id in task info.
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_RUN_TIME_COUNTER_TYPE_U64=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
# RTCM hub wakes consumers on notification index 1 (index 0 is used by IDF APIs).
CONFIG_FREERTOS_TASK_NOTIFICATION_ARRAY_ENTRIES=2
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# ---- Compiler -------------------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_COMPILER_STACK_CHECK_MODE_NORM=y

# ---- Console: UART0 through the CH343P bridge; native USB is not wired -----
# Stock UART0 console (GPIO43/44) at 115200, the same rate the ROM bootloader
# prints at, so one serial capture sees everything from reset onwards. The
# default console has no baud setting of its own (it is always 115200), so
# CONFIG_ESP_CONSOLE_UART_BAUDRATE is not set here: Kconfig would ignore it
# and report it as not visible.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# Native USB-Serial-JTAG is not connected: keep its clock off in the app.
CONFIG_USJ_ENABLE_USB_SERIAL_JTAG=n
# ...and let Wi-Fi init power the USB PHY down (the S3 default keeps it on,
# which the IDF help says can lower Wi-Fi performance).
CONFIG_ESP_PHY_ENABLE_USB=n

# ---- GNSS UART: keep receiving while flash is being written ----------------
CONFIG_UART_ISR_IN_IRAM=y

# ---- Watchdogs, panic, core dump -------------------------------------------
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU0=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y

# ---- OTA: app rollback if a new image never confirms itself ----------------
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# ---- TLS: full CA bundle (GitHub, its asset CDN, TLS casters) --------------
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
# Chains whose top certificate is a cross-signed copy of a bundled root (the
# Onocoy TLS port serves one) verify against the bundled root. ~700 B heap.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# ---- HTTP server (web UI + WebSocket) --------------------------------------
CONFIG_HTTPD_WS_SUPPORT=y
# The handshake is refused with an HTTP error (401, 403, 421, 503) before the
# upgrade; the client is registered right after it.
CONFIG_HTTPD_WS_PRE_HANDSHAKE_CB_SUPPORT=y
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y

# ---- Networking -------------------------------------------------------------
# Casters (up to 8) + web clients (httpd 7) + captive DNS + OTA + SNTP + probes.
CONFIG_LWIP_MAX_SOCKETS=24
# Same budget for TCP PCBs: lwIP only evicts lower-priority connections, so a
# full pool would refuse the next web client or OTA download.
CONFIG_LWIP_MAX_ACTIVE_TCP=24
CONFIG_LWIP_LOCAL_HOSTNAME="onocoydiy"
# DNS fallback server used when DHCP leaves no working one (needs
# LWIP_DNS_MAX_SERVERS >= 3, the default). Compile-time, not a user setting.
CONFIG_LWIP_FALLBACK_DNS_SERVER_SUPPORT=y
CONFIG_LWIP_FALLBACK_DNS_SERVER_ADDRESS="1.1.1.1"
# Wi-Fi credentials are owned by the settings component, not the driver.
CONFIG_ESP_WIFI_NVS_ENABLED=n
# SNTP: a DHCP-provided NTP server (option 42) at index 0, pool.ntp.org at
# index 1, so networks that block outside NTP still get the time.
CONFIG_LWIP_DHCP_GET_NTP_SRV=y
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# ---- mDNS (espressif/mdns, network component): <hostname>.local -----------
# One service (the web page, _http._tcp) plus a spare. The responder only
# answers: no browsing, no console commands. Its data lives in PSRAM; its
# task stack stays internal at the component's default (4096). The default
# lwIP raw-PCB networking is kept (MDNS_NETWORKING_SOCKET off), so it uses
# none of the 24 lwIP sockets. The predefined STA and AP interfaces stay on
# (component defaults): the name answers on the home network and on the
# setup/recovery AP (192.168.4.1 there).
CONFIG_MDNS_MAX_SERVICES=2
CONFIG_MDNS_ENABLE_BROWSE=n
CONFIG_MDNS_ENABLE_CONSOLE_CLI=n
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y
# No interface uses the predefined Ethernet key: the station has no Ethernet,
# and the QEMU build's emulated Ethernet port registers under the station
# key (so mDNS answers there through the STA interface).
CONFIG_MDNS_PREDEF_NETIF_ETH=n
