menu "Station: health monitor"

    config HEALTH_GNSS_STALL_S
        int "Seconds without RTCM before the GNSS path counts as stalled"
        range 3 600
        default 10
        help
            First rung of the recovery ladder. PROVISIONAL, to be confirmed
            on hardware.

    config HEALTH_SURVEY_HOLDS_RTCM
        bool "The receiver sends no RTCM while it surveys its position"
        default n
        help
            Set this if the receiver holds back all RTCM output during its
            survey-in. While the station's survey window is open the
            recovery ladder then declares no stall and lets no grace period
            run out; once the window ends, missing RTCM is a normal stall.
            Leave it off when observations keep flowing during the survey.
            PROVISIONAL, to be confirmed on hardware.

    config HEALTH_TASK_STACK
        int "Health monitor task stack (bytes)"
        range 4096 16384
        default 6144
        help
            Internal RAM: the task writes settings (BOOT-button actions) and
            journal records, and formats log lines. PROVISIONAL, to be tuned
            from the task's stack high-water mark.

    config HEALTH_HEAP_FRAGMENT_KB
        int "Alert when the largest free internal block drops below (KB)"
        range 4 128
        default 16

    config HEALTH_BUTTON_ADMIN_S
        int "BOOT button hold to clear the admin password (s)"
        range 3 30
        default 10
        help
            Clears the admin password and starts the recovery setup AP so
            the owner can set a new one. Physical presence is the
            authorisation.

    config HEALTH_BUTTON_FACTORY_S
        int "BOOT button hold for a factory reset (s)"
        range 10 60
        default 20

    config HEALTH_NET_REBOOT_MIN_INTERVAL_H
        int "Minimum hours between network-ladder reboots"
        range 1 48
        default 6

endmenu
