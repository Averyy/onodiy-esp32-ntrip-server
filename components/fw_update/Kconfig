menu "Station: firmware updates"

    config FW_UPDATE_GITHUB_REPO
        string "GitHub repository serving releases (owner/name)"
        default "Averyy/onocoydiy-esp-um982"
        help
            Releases of this repository carry the app image, the receiver
            package and a manifest. The repository must be public: devices
            send no access token. Without a manifest key (below) this is what
            a release is trusted for: it is fetched over HTTPS, certificate
            checked against the CA bundle, from GitHub's release hosts for
            this repository only, and every file must match the manifest's
            size and SHA-256. Forks point this at their own repository. Empty
            or not "owner/name": update checks are off. Only a build with a
            manifest key also takes a runtime override from settings
            (ota/repo).

    config FW_UPDATE_MANIFEST_ASSET
        string "Release manifest asset name"
        default "manifest.json"

    config FW_UPDATE_MANIFEST_KEY_1
        string "Manifest signing key 1 (public, hex; optional)"
        default ""
        help
            Optional. Leave empty (the default) and release manifests need no
            signature: the repository above, HTTPS and the per-file size and
            SHA-256 are the trust. Set it (e.g. a fork that signs its
            releases) and only manifests signed with key 1 or key 2 are used;
            an unsigned manifest is then refused, and so is everything when
            no configured key parses. The value is the public half of the
            signing key, the uncompressed P-256 point (04 || X || Y) as 130
            hex digits, e.g. from `openssl ec -pubin -in key.pub -text
            -noout` (colons and line breaks are ignored). The release
            workflow signs when the MANIFEST_SIGNING_KEY secret holds the
            private key (tools/release_manifest.py).

    config FW_UPDATE_MANIFEST_KEY_2
        string "Manifest signing key 2 (public, hex)"
        default ""
        help
            Second accepted key, so the signing key can be rotated: ship
            the next key here before signing releases with it. Setting
            either key makes signatures required.

    config FW_UPDATE_HTTP_TIMEOUT_MS
        int "HTTP network timeout (ms)"
        range 5000 60000
        default 15000
        help
            Per connect/read timeout of the update check and the downloads.

    config FW_UPDATE_CHECK_INTERVAL_H
        int "Hours between automatic update checks (not a runtime setting)"
        range 24 168
        default 24
        help
            The check only looks for new releases and shows a banner in the
            web UI; installing always needs the user's confirmation. The
            first check runs a few minutes after boot.

    config FW_UPDATE_HTTP_BUF_SIZE
        int "HTTP client receive/transmit buffer (bytes)"
        range 2048 16384
        default 4096
        help
            GitHub release downloads redirect to signed CDN URLs that are
            often longer than 1000 characters. The request line is built in
            the transmit buffer, so both buffers must hold such a URL.

    config FW_UPDATE_MAX_REDIRECTS
        int "Maximum HTTP redirects followed"
        range 1 10
        default 5

    config FW_UPDATE_MANIFEST_MAX_KB
        int "Largest manifest accepted (KB)"
        range 4 64
        default 8

    config FW_UPDATE_CONFIRM_S
        int "Stage 1: seconds before a new app image is confirmed"
        range 20 600
        default 60
        help
            Until then the bootloader rolls back on any reset, including a
            power blip, so the window is short. The real acceptance test is
            stage 2.

    config FW_UPDATE_VERIFY_WINDOW_S
        int "Stage 2: seconds a new image has to reach the saved baseline"
        range 120 3600
        default 600

    config FW_UPDATE_CRASH_WATCH_H
        int "Stage 2: hours of crash watch after an update"
        range 1 168
        default 24

    config FW_UPDATE_CRASH_REVERT_COUNT
        int "Crash resets during the watch that revert the update"
        range 1 20
        default 3

endmenu
